# Database — matches docker-compose.yml credentials
DATABASE_URL=postgresql://knowledge_hub:knowledge_hub_dev@localhost:5432/knowledge_hub

# Qdrant — host port 6334 (shifted from default 6333 to avoid colliding
# with the project-1 Qdrant instance)
QDRANT_HOST=localhost
QDRANT_PORT=6334

# Authentication
# SECRET_KEY: generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM
ANTHROPIC_API_KEY=
