# Database — matches docker-compose.yml credentials for local dev.
# In production this is the managed Postgres connection string.
DATABASE_URL=postgresql://knowledge_hub:knowledge_hub_dev@localhost:5432/knowledge_hub

# Qdrant — local dev uses host/port (docker-compose, host port 6334).
QDRANT_HOST=localhost
QDRANT_PORT=6334
# Qdrant Cloud — set these in production; when QDRANT_URL is set it takes
# precedence over host/port. Leave blank for local.
QDRANT_URL=
QDRANT_API_KEY=

# Authentication
# SECRET_KEY: generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Embeddings — Voyage AI (hosted)
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4-large

# LLM
ANTHROPIC_API_KEY=

# CORS — comma-separated list of allowed frontend origins.
# Local dev uses the Vite proxy so this isn't needed, but it's a safe default.
# In production set this to the deployed frontend URL.
CORS_ORIGINS=http://localhost:5173
