# Frontend build-time config (Vite inlines VITE_* vars at build).
#
# Leave VITE_API_URL blank for local dev — the Vite proxy in vite.config.js
# forwards /api to the local backend (no CORS needed).
#
# In production, set this to the deployed backend's base URL, e.g.
#   VITE_API_URL=https://knowledge-hub-api.onrender.com
VITE_API_URL=
